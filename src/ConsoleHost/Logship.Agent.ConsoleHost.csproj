<Project Sdk="Microsoft.NET.Sdk.Web">
    <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />

    <PropertyGroup>
      <OutputType>Exe</OutputType>
      <TargetFramework>$(NetCoreVersion)</TargetFramework>
      <RuntimeIdentifiers>$(RuntimeIdentifiers)</RuntimeIdentifiers>
      <ServerGarbageCollection>false</ServerGarbageCollection>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <PublishAot>true</PublishAot>
      <PublishTrimmed>true</PublishTrimmed>
      <TrimMode>full</TrimMode>
      <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
      <StripSymbols>true</StripSymbols>
      <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
      <IsAotCompatible>true</IsAotCompatible>
      <InvariantGlobalization>true</InvariantGlobalization>
      <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
      <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Grpc.AspNetCore" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
      <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Core\Logship.Agent.Core\Logship.Agent.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="config/appsettings.*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <Target Name="PublishPlatformConfiguration" AfterTargets="Publish">
      <PropertyGroup>
        <PlatformConfiguration Condition="$(RuntimeIdentifier.StartsWith('win-'))">windows</PlatformConfiguration>
        <PlatformConfiguration Condition="$(RuntimeIdentifier.StartsWith('osx-'))">macos</PlatformConfiguration>
        <PlatformConfiguration Condition="$(RuntimeIdentifier.StartsWith('linux-'))">linux</PlatformConfiguration>
      </PropertyGroup>
      <Copy Condition="'$(PlatformConfiguration)' != ''"
            SourceFiles="config/appsettings.$(PlatformConfiguration).json"
            DestinationFiles="$(PublishDir)appsettings.json" />
      <Copy SourceFiles="config/appsettings.full.json" DestinationFolder="$(PublishDir)" />
      <Copy Condition="$(RuntimeIdentifier.StartsWith('linux-musl-'))"
            SourceFiles="config/appsettings.openwrt.json" DestinationFolder="$(PublishDir)" />
    </Target>

</Project>
