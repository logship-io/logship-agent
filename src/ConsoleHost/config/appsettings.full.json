{
  // This file is a reference. Copy settings into your active appsettings.json and enable the sources you need.
  // Source intervals are .NET TimeSpan strings (hours:minutes:seconds). A missing source is off unless noted.
  // If a source section is present, set enabled explicitly. Most sources default to enabled when configured.
  "Kestrel": {
    "Endpoints": {
      "Default": {
        // Local HTTP status endpoint. The optional OTLP listener below uses a separate port.
        "Url": "http://127.0.0.1:57421"
      }
    }
  },
  "Output": {
    // Required backend base URL. Use HTTPS for remote backends. The agent adds its API paths.
    "endpoint": "http://localhost:5000",
    // Required Logship account ID. Replace this placeholder.
    "account": "00000000-0000-0000-0000-000000000000",
    // Interval between attempts to upload buffered records. Default 10 seconds.
    "interval": "00:00:10",
    // Maximum queued records (5,000–1,000,000). New records can be dropped when the queue is full.
    "maximumBufferSize": 10000,
    // Maximum records per HTTP request (1,000–1,000,000). Larger flushes are split into batches.
    "maximumFlushSize": 10000,
    // Writable persistent directory for credentials and checkpoints. Relative to the configuration directory.
    "dataPath": "./logship-agent-local-storage",
    "health": {
      // Uptime record interval. Default one minute.
      "interval": "00:01:00"
    },
    "registration": {
      // Initial enrollment token. Once enrolled, the saved refresh token takes precedence.
      "registrationToken": ""
    }
  },
  "Logging": {
    "LogLevel": {
      // Minimum routine log severity. Category-specific overrides are supported.
      "Default": "Warning"
    }
  },
  "Sources": {
    // Agent diagnostics are enabled even when the Internals section is omitted.
    "Internals": {
      // Set false to turn off all process metrics, internal instruments, and traces.
      "enabled": true,
      // Sampling and export interval for this source. Default one minute.
      "interval": "00:01:00",
      // One record with process and garbage collection statistics per interval.
      "enableProcessMetrics": true,
      // Individual internal instrument measurements. Opt-in, up to 100 pending records per interval.
      "enableMetrics": false,
      // Individual agent spans. Opt-in, up to 100 pending records per interval.
      "enableTracing": false
    },
    // Host and runtime inventory, including the agent command line. Default interval when configured is 15 seconds.
    "SystemInformation": { "enabled": true, "interval": "01:00:00" },
    // CPU usage, when supported by the host. Keep disabled to avoid frequent metric records.
    "System.CPU": { "enabled": false, "interval": "00:00:15" },
    // Disk inventory and usage. The service can only see accessible drives.
    "DiskInformation": { "enabled": false, "interval": "00:00:15" },
    // Network interface and traffic counters. Volume grows with the number of interfaces.
    "NetworkInformation": { "enabled": false, "interval": "00:00:15" },
    // Per-process inventory. Visibility and volume depend on the OS, privileges, and process count.
    "ProcessInformation": { "enabled": false, "interval": "00:00:15" },
    // Disk attachment and removal. Interval controls reconciliation when native notifications are unavailable or missed.
    "StorageEvents": { "enabled": false, "interval": "00:00:05" },
    // Network interface and address changes. Interval controls periodic reconciliation.
    "NetworkEvents": { "enabled": false, "interval": "00:00:15" },
    // Native power state changes where supported. No polling interval.
    "PowerEvents": { "enabled": false },
    // USB inventory and changes where supported. The service needs access to device metadata.
    "USB": { "enabled": false, "interval": "00:00:30" },
    // Linux /proc memory statistics. Requires readable /proc.
    "Proc": { "enabled": false, "interval": "00:00:15" },
    // Linux open-file inventory. Cross-user visibility requires permission to inspect other processes.
    "Proc.OpenFiles": { "enabled": false, "interval": "00:00:15" },
    // Linux kernel module inventory. Requires readable /proc/modules.
    "Proc.Modules": { "enabled": false, "interval": "00:00:15" },
    "LogFile": {
      // Text file collection. Grant read and directory traversal permissions for matching paths.
      "enabled": false,
      // Globs relative to workingDirectory. Use ** for recursive matches.
      "include": ["*.log"],
      // Matching exclusions take precedence. Default empty.
      "exclude": ["*.tmp"],
      // Directory for the globs. Omit to use the agent's current directory.
      "workingDirectory": "/var/log",
      // Text encoding. Defaults to UTF-8 and falls back to it for unknown names.
      "encoding": "utf-8",
      // Read existing contents on first discovery. Saved checkpoints take precedence.
      "startAtBeginning": false,
      // Ignore saved checkpoints. Can replay files when combined with startAtBeginning.
      "ignoreCheckpoints": false,
      // Ignore files older than this many seconds. Null means no age limit.
      "ignoreOlderSecs": null,
      // Minimum time between glob scans, in milliseconds. Default 1000.
      "globMinimumCooldownMs": 1000,
      // File read buffer, in bytes. Default 8192.
      "readBufferSize": 8192,
      // Limit for a terminated line. The current reader applies it to decoded characters.
      "maxLineBytes": 1048576,
      // Omit this section for one record per line. Use either multiline or JSON Lines for a given file.
      "multiline": {
        // A matching line begins a new record. Subsequent lines are appended to it.
        "startPattern": "^\\d{4}-\\d{2}-\\d{2}",
        // Reserved settings. The reader currently uses the start pattern for grouping.
        "conditionPattern": null,
        "mode": "startPattern",
        // Time in milliseconds after which new input ends the previous multiline record.
        "timeoutMs": 1000
      },
      "jsonLines": {
        // Parse each line as a JSON object and add its fields to the record.
        "enabled": false,
        // Drop malformed JSON lines. Set false to preserve them as text.
        "skipInvalidLines": true,
        // Optional field names for timestamp and message extraction.
        "timestampField": null,
        "messageField": null
      }
    },
    "JournalCtl": {
      // Linux systemd journal. Requires libsystemd and journal read permission.
      "enabled": false,
      // Native sd-journal open flags as a numeric bitmask. Zero uses the native defaults.
      "flags": 0,
      // Additional journal fields to retain, beyond those included by the collector.
      "includeFields": ["USERID"],
      // Journal filters. Each group lists any or all predicates, using field presence or equality.
      "filters": [{
        "matchAny": [{ "hasField": "CONTAINER_NAME" }],
        "matchAll": [{ "fieldEquals": { "field": "SYSLOG_IDENTIFIER", "value": "kernel" } }]
      }]
    },
    "Linux.AuthEvents": {
      // Parses Linux authentication logs. Grant read permission for the configured files.
      "enabled": false,
      "interval": "00:00:15",
      // Absolute paths, usually distribution-specific.
      "logPaths": ["/var/log/auth.log", "/var/log/secure"],
      // Start at the current end instead of replaying existing entries.
      "startAtEnd": true
    },
    "Linux.SshPosture": {
      // Reads sshd settings. Grant read permission to its configuration and any included files.
      "enabled": false,
      "interval": "00:00:15",
      "configPath": "/etc/ssh/sshd_config"
    },
    "Linux.PersistenceInventory": {
      // Inventory of startup and scheduled tasks. Inspects only readable paths.
      "enabled": false,
      "interval": "00:00:15",
      // Systemd unit and override directories.
      "systemdDirectories": ["/etc/systemd/system", "/usr/lib/systemd/system", "/lib/systemd/system"],
      // System and user cron directories.
      "cronDirectories": ["/etc/cron.d", "/etc/cron.daily", "/etc/cron.hourly", "/etc/cron.monthly", "/etc/cron.weekly", "/var/spool/cron", "/var/spool/cron/crontabs"],
      // Shell startup files and directories to inventory.
      "profilePaths": ["/etc/profile", "/etc/profile.d", "/etc/bash.bashrc", "/etc/zsh/zshrc", "/root/.bashrc", "/root/.profile"],
      // Legacy startup script path.
      "rcLocalPath": "/etc/rc.local"
    },
    "Linux.Docker": {
      // Docker events and logs. Limit Docker socket access to trusted operators.
      "enabled": false,
      "interval": "00:00:15",
      // Use the Docker API when available. The agent can also read JSON log files directly.
      "useDockerSocket": true,
      "collectContainerLogs": true,
      "collectDockerEvents": true,
      // Docker UNIX socket and root for JSON log files, respectively.
      "dockerSocketPath": "/var/run/docker.sock",
      "jsonLogRoot": "/var/lib/docker/containers"
    },
    "Linux.80211": {
      // Linux Wi-Fi management frame collection. Requires libpcap, iw, and a prepared monitor interface.
      "enabled": false,
      "interface": "mon0",
      // Backend record schema name.
      "schema": "Linux.80211.Management",
      // Per-channel dwell time when hopping. Default 250 ms.
      "channelDwell": "00:00:00.250",
      // Frequencies in MHz. An empty list leaves the interface on its current channel.
      "frequenciesMHz": []
    },
    "Windows.ETW": {
      // Windows ETW collection. The service identity needs permission to manage sessions and read providers.
      "enabled": false,
      // Null selects the agent's default session prefix.
      "sessionNamePrefix": null,
      // Remove stale sessions and reuse an existing named session respectively.
      "cleanupOldSessions": true,
      "reuseExistingSession": true,
      "providers": [{
        // Specify the provider GUID or name. A GUID takes precedence if both are supplied.
        "providerGuid": null,
        "providerName": "Microsoft-Windows-Kernel-Process",
        // ETW severity and provider keyword mask. -1 enables all keywords.
        "level": "Informational",
        "keywords": -1
      }]
    },
    "Windows.PerformanceCounters": {
      // Windows Performance Counter paths. The service identity needs read access to each counter.
      "enabled": false,
      // Sampling and wildcard instance refresh intervals, respectively.
      "interval": "00:00:15",
      "counterRefreshInterval": "00:01:00",
      "counters": ["\\Processor(_Total)\\% Processor Time"]
    },
    "SyslogTcp": {
      // TCP syslog listener. Use a loopback or trusted interface.
      "enabled": false,
      "endpoint": "127.0.0.1",
      // Default 514, which can require elevated bind permission. This example uses 5140.
      "port": 5140
    },
    "UDPListener": {
      // UDP listener. An explicit port (1–65535) is required when configured.
      "enabled": false,
      "port": 49999
    },
    "Otlp": {
      // OTLP gRPC listener for logs, metrics and traces. Binds to all interfaces when enabled.
      "enabled": false,
      "port": 4317
    },
    "HealthChecks": {
      // Periodic HTTP requests to configured endpoints. The service needs outbound access.
      "enabled": false,
      "targets": [{
        "endpoint": "https://example.com",
        // Per-target request interval. Default 15 seconds.
        "interval": "00:05:00",
        // Capture response content only when it is appropriate to send it to Logship.
        "includeResponseHeaders": false,
        "includeResponseBody": false
      }]
    },
    "Prometheus": {
      // Periodic scrapes. Volume depends on the number of series returned by each target.
      "enabled": false,
      "targets": [{
        "endpoint": "http://localhost:9100/metrics",
        "interval": "00:00:15",
        // Optional request headers. Protect the settings file if these contain credentials.
        "headers": {}
      }]
    },
    "MQTT": {
      // MQTT subscription. Use a restricted topic and protect broker credentials.
      "enabled": false,
      "brokerAddress": "localhost",
      "brokerPort": 1883,
      "clientId": "logship-agent",
      "username": null,
      "password": null,
      // A # matches all topics. Use the narrowest subscription that covers your data.
      "topic": "#",
      "useTls": false,
      // Combine messages in the collector's combined record format.
      "combined": true
    },
    "NmapScanner": {
      // Optional nmap inventory for networks the operator is authorized to scan. Requires nmap on PATH.
      "enabled": false,
      "interval": "00:00:15",
      // Use OS shell execution for the nmap process. Default false.
      "shellExec": false,
      "subnets": [{
        // Target network in CIDR notation, and per-target arguments. Default arguments are -T4 -n.
        "subnet": "192.0.2.0/24",
        "nmapArgs": "-T4 -n"
      }]
    }
  }
}
