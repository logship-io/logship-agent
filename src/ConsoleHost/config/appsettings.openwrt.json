{
  "Kestrel": {
    "Endpoints": {
      "Default": {
        // Local HTTP status endpoint. Keep it on loopback unless remote access is required.
        "Url": "http://127.0.0.1:57421"
      }
    }
  },
  "Output": {
    // Set these to your Logship backend base URL and account ID.
    "endpoint": "http://localhost:5000",
    "account": "00000000-0000-0000-0000-000000000000",
    // Store refresh credentials and file checkpoints here. Relative to the configuration directory.
    "dataPath": "./logship-agent-local-storage",
    "registration": {
      // Use the agent's registration token for enrollment. Protect this file while the token is present.
      "registrationToken": ""
    }
  },
  "Logging": {
    "LogLevel": {
      // Use Information or Debug temporarily to diagnose routine activity.
      "Default": "Warning"
    }
  },
  "Sources": {
    "SystemInformation": {
      // Report host and runtime inventory hourly. This includes the agent's command line.
      "enabled": true,
      "interval": "01:00:00"
    },
    "SyslogTcp": {
      // Optional TCP syslog receiver. Configure a sender and choose the listening address explicitly.
      "enabled": false,
      "endpoint": "127.0.0.1",
      "port": 5140
    },
    "Proc": {
      // Optional /proc memory metrics. Start with a slow interval on constrained devices.
      "enabled": false,
      "interval": "00:05:00"
    }
  }
}
